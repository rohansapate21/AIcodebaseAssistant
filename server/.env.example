# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codebase-assistant?retryWrites=true&w=majority

# Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIza...

# GitHub Personal Access Token (optional but recommended — raises rate limit from 60 to 5000 req/hr)
# Create at: https://github.com/settings/tokens  (no scopes needed for public repos)
GITHUB_TOKEN=ghp_...

# Express server port
PORT=3001

# URL of the React dev server (used for CORS)
CLIENT_URL=http://localhost:5173
